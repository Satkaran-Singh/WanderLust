<div class="flash-container">

    <% if(success && success.length){ %>
        <div class="alert custom-flash alert-success alert-dismissible fade show"
             role="alert">

            <div class="flash-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="flash-content">
                <strong>Success!</strong>
                <p><%= success %></p>
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    <% } %>

    <% if(error && error.length){ %>
        <div class="alert custom-flash alert-danger alert-dismissible fade show"
             role="alert">

            <div class="flash-icon">
                <i class="fa-solid fa-circle-exclamation"></i>
            </div>

            <div class="flash-content">
                <strong>Something went wrong!</strong>
                <p><%= error %></p>
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    <% } %>

</div>