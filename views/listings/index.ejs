<%- layout("/layouts/boilerplate") %>
<body>
    <button class="btn explore-btn d-lg-none mb-3"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#categoryFilters"
        aria-expanded="false"
        aria-controls="categoryFilters">
        <i class="fa-solid fa-bars"></i> Explore Categories
    </button>
    <div class="collapse d-lg-block" id="categoryFilters">
        <div id="filters">
            <div class="filter">
                <a href="/listings/category/trending"><div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p></a>
            </div>
            <div class="filter">
                <a href="/listings/category/rooms"><div><i class="fa-solid fa-bed"></i></i></div>
                <p>Rooms</p></a>
            </div>
            <div class="filter">
                <a href="/listings/category/iconicCities"><div><i class="fa-solid fa-mountain-city"></i></div>
                <p>Iconic Cities</p></a>
            </div>
            <div class="filter">
                <a href="/listings/category/mountains"><div><i class="fa-solid fa-mountain"></i></i></div>
                <p>Mountains</p></a>
            </div>
            <div class="filter">
                <a href="/listings/category/castles"><div><i class="fa-solid fa-fort-awesome"></i></div>
                <p>Castles</p></a>
            </div>
            <div class="filter">
                <a href="/listings/category/amazingPools"><div><i class="fa-solid fa-person-swimming"></i></i></div>
                <p>Amazing Pools</p></a>
            </div>
            <div class="filter">
                <a href="/listings/category/camping"><div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p></a>
            </div>
            <div class="filter">
                <a href="/listings/category/farms"><div><i class="fa-solid fa-cow"></i></i></div>
                <p>Farms</p></a>
            </div>
            <div class="filter">
                <a href="/listings/category/arctic"><div><i class="fa-solid fa-snowflake"></i></div>
                <p>Arctic</p></a>
            </div>
            <div class="filter">
                <a href="/listings/category/other"><div><i class="fa-solid fa-otter"></i></div>
                <p>Any Other</p></a>
            </div>
            <div class="tax-toggle">
                <div class="form-check-reverse form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                    <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-2">
        <% for(let listing of allListings) { %>
            <div class="col">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card listing-card h-100">
                        <img
                            src="<%= listing.image.url %>"
                            class="card-img-top"
                            alt="<%= listing.title %>"
                            loading="lazy"
                        >

                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listing.title %></b>
                                <br>
                                <span>
                                    &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
                                </span>
                                <i class="tax-info">&nbsp; +18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
            </div>
        <% } %>
    </div>
</body>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        let taxInfo =document.getElementsByClassName("tax-info");
        for(info of taxInfo) {
            if(info.style.display != "inline"){
                info.style.display = "inline";
            }else{
                info.style.display = "none";
            }
        }
    });

    // Active Category
    let currentPath = window.location.pathname;

    document.querySelectorAll(".filter a").forEach(link => {
        if (link.pathname === currentPath) {
            link.closest(".filter").classList.add("active");
        }
    });

</script>
